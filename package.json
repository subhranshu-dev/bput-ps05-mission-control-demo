{
  "name": "aegis-mission-control-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "test:unit": "esbuild tests/engine.test.ts --bundle --platform=node --format=esm --outfile=.tests/engine.test.mjs \"--define:import.meta.env.DEV=false\" --log-level=warning && node --test .tests/engine.test.mjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:restricted": "node tests/restricted.cjs",
    "test:takeoff": "node tests/takeoff-hold.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
